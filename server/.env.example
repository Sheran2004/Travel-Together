# --- Required ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/travel-together
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# --- Optional: media storage (recommended in production). Without these, uploads go to server/uploads (dev only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: password-reset email. Without it, the reset link is printed in the server console ---
SMTP_URL=
MAIL_FROM=Travel Together <no-reply@yourdomain.com>

# --- Optional: TURN server for calls across strict NATs (STUN is used by default) ---
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Your contact email, sent to OpenStreetMap geocoding (required by their usage policy) ---
CONTACT_EMAIL=
