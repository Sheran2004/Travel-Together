# --- Required ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/travel-together
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# --- Optional: media storage (recommended in production). Without these, uploads go to server/uploads (dev only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: password-reset email. Without it, the reset link is printed in the server console ---
SMTP_URL=
MAIL_FROM=Travel Together <no-reply@yourdomain.com>

# --- Optional: TURN server for calls across strict NATs (STUN is used by default) ---
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Your contact email, sent to OpenStreetMap geocoding (required by their usage policy) ---
CONTACT_EMAIL=

# --- Background push notifications. Generate keys once with:  npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- TURN for calls that cannot connect directly (strict NATs, mobile data, offices) ---
# Comma separated URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
# Option A (recommended, self-hosted coturn with use-auth-secret): temporary credentials are generated per call
TURN_SECRET=
# Option B (hosted providers like Metered/Twilio): static credentials
# TURN_USERNAME= and TURN_CREDENTIAL= (see the lines above)
